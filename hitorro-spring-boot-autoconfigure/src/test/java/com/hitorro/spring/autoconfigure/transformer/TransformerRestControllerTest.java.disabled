package com.hitorro.spring.autoconfigure.transformer;

import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.context.ApplicationContext;
import org.springframework.http.MediaType;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;

import static org.hamcrest.Matchers.*;
import static org.junit.jupiter.api.Assertions.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * Integration tests for Transformer REST API endpoints.
 * 
 * These tests verify that:
 * 1. TransformerAutoConfiguration is loaded
 * 2. REST endpoints are registered  
 * 3. Transformation queries work
 * 4. Document/content endpoints exist
 * 
 * This test uses a full Spring Boot application context with DMS initialized,
 * similar to how the hitorro-example-springboot tests work.
 * 
 * The test profile (application-transformer-test.yml) configures:
 * - In-memory H2 database
 * - DMS with service framework
 * - Transformer auto-configuration
 */
@SpringBootTest(classes = TestTransformerConfiguration.class)
@ActiveProfiles("transformer-test")
@AutoConfigureMockMvc
public class TransformerRestControllerTest {
    
    private static final Logger logger = LoggerFactory.getLogger(TransformerRestControllerTest.class);
    
    @Autowired
    private MockMvc mockMvc;
    
    @Autowired
    private ApplicationContext context;
    
    // ==================== Auto-Configuration Tests ====================
    
    @Test
    @DisplayName("Test 1: TransformerAutoConfiguration loads and registers beans")
    public void testTransformerAutoConfigurationLoaded() {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing TransformerAutoConfiguration is loaded...");
        logger.info("══════════════════════════════════════════════════");
        
        // Check if beans are registered
        assertTrue(context.containsBean("renditionTransformationController"),
            "RenditionTransformationController bean should be registered");
        
        assertTrue(context.containsBean("documentContentController"),
            "DocumentContentController bean should be registered");
        
        logger.info("✓ TransformerAutoConfiguration beans are registered");
    }
    
    // ==================== Transformation Endpoints Tests ====================
    
    @Test
    @DisplayName("Test 2: /api/transformer/transformations endpoint exists")
    public void testTransformationsEndpointExists() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing /api/transformer/transformations endpoint...");
        logger.info("══════════════════════════════════════════════════");
        
        MvcResult result = mockMvc.perform(get("/api/transformer/transformations")
                .param("sourceMimeType", "application/pdf")
                .accept(MediaType.APPLICATION_JSON))
            .andReturn();
        
        int status = result.getResponse().getStatus();
        String body = result.getResponse().getContentAsString();
        
        logger.info("Response status: {}", status);
        logger.info("Response body: {}", body);
        
        assertNotEquals(404, status, "Endpoint should NOT return 404 - it should exist!");
        
        logger.info("✓ Transformations endpoint exists (not 404)");
    }
    
    @Test
    @DisplayName("Test 3: /api/transformer/transformations returns JSON structure")
    public void testTransformationsReturnsJson() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing transformations endpoint returns JSON...");
        logger.info("══════════════════════════════════════════════════");
        
        MvcResult result = mockMvc.perform(get("/api/transformer/transformations")
                .param("sourceMimeType", "application/pdf")
                .accept(MediaType.APPLICATION_JSON))
            .andReturn();
        
        String body = result.getResponse().getContentAsString();
        logger.info("Response: {}", body);
        
        // Should return JSON (either success or error, but not 404)
        assertTrue(body.contains("{") && body.contains("}"),
            "Response should be JSON format");
        
        logger.info("✓ Endpoint returns JSON response");
    }
    
    @Test
    @DisplayName("Test 4: /api/transformer/available-targets endpoint exists")
    public void testAvailableTargetsEndpoint() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing /api/transformer/available-targets endpoint...");
        logger.info("══════════════════════════════════════════════════");
        
        MvcResult result = mockMvc.perform(get("/api/transformer/available-targets")
                .param("sourceMimeType", "application/pdf")
                .accept(MediaType.APPLICATION_JSON))
            // Should NOT be 404
            .andReturn();
        
        logger.info("Response status: {}", result.getResponse().getStatus());
        logger.info("✓ Available targets endpoint exists");
    }
    
    @Test
    @DisplayName("Test 5: /api/transformer/queue endpoint exists")
    public void testQueueEndpointExists() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing /api/transformer/queue endpoint...");
        logger.info("══════════════════════════════════════════════════");
        
        String requestBody = """
            {
                "sourceContentGuid": "Content:test123",
                "targetMimeType": "image/jpeg",
                "methodName": "pdf_to_image",
                "methodArgs": "format=jpeg,dpi=150"
            }
            """;
        
        MvcResult result = mockMvc.perform(post("/api/transformer/queue")
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody)
                .accept(MediaType.APPLICATION_JSON))
            // Should NOT be 404
            .andReturn();
        
        logger.info("Response status: {}", result.getResponse().getStatus());
        logger.info("✓ Queue endpoint exists (may fail validation but not 404)");
    }
    
    // ==================== Document/Content Endpoints Tests ====================
    
    @Test
    @DisplayName("Test 6: /api/documents/recent endpoint exists")
    public void testDocumentsRecentEndpoint() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing /api/documents/recent endpoint...");
        logger.info("══════════════════════════════════════════════════");
        
        MvcResult result = mockMvc.perform(get("/api/documents/recent")
                .accept(MediaType.APPLICATION_JSON))
            // Should NOT be 404
            .andReturn();
        
        logger.info("Response status: {}", result.getResponse().getStatus());
        logger.info("✓ Documents recent endpoint exists");
    }
    
    @Test
    @DisplayName("Test 7: /api/documents/search endpoint exists")
    public void testDocumentsSearchEndpoint() throws Exception {
        logger.info("══════════════════════════════════════════════════");
        logger.info("Testing /api/documents/search endpoint...");
        logger.info("══════════════════════════════════════════════════");
        
        MvcResult result = mockMvc.perform(get("/api/documents/search")
                .param("q", "test")
                .accept(MediaType.APPLICATION_JSON))
            // Should NOT be 404
            .andReturn();
        
        logger.info("Response status: {}", result.getResponse().getStatus());
        logger.info("✓ Documents search endpoint exists");
    }
    
    // ==================== Summary Test ====================
    
    @Test
    @DisplayName("Test 8: Summary - All endpoints registered")
    public void testAllEndpointsRegistered() {
        logger.info("══════════════════════════════════════════════════");
        logger.info("SUMMARY: Checking all transformer endpoints...");
        logger.info("══════════════════════════════════════════════════");
        
        String[] endpoints = {
            "/api/transformer/transformations",
            "/api/transformer/available-targets",
            "/api/transformer/queue",
            "/api/transformer/content/{guid}/available-transformations",
            "/api/documents/recent",
            "/api/documents/search"
        };
        
        logger.info("Expected endpoints:");
        for (String endpoint : endpoints) {
            logger.info("  - {}", endpoint);
        }
        
        // If we get here, the configuration loaded
        assertTrue(context.containsBean("renditionTransformationController"),
            "All transformer endpoints should be registered via RenditionTransformationController");
        
        logger.info("✓ All transformer REST endpoints configured");
    }
}
